# Absolute origin for canonical URLs, sitemap.xml, og:image and JSON-LD.
# Without it these fall back to http://localhost:3000.
# Set the real value in Vercel: Project -> Settings -> Environment Variables.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- contact form (Resend) ---
# Get a key at https://resend.com -> API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Where enquiries land. Defaults to site.email if unset.
# NOTE: until a sending domain is verified in Resend, the shared
# onboarding@resend.dev sender only delivers to the Resend account's
# own address, so this must match that address.
CONTACT_TO_EMAIL=you@example.com
# Verified sending address. Until you verify a domain in Resend,
# leave this unset and it falls back to onboarding@resend.dev.
# CONTACT_FROM_EMAIL=hello@your-domain.com
